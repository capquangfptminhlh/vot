    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "jest": "^30.1.3",
    "prisma": "7.10.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
