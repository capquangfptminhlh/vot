    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/platform-socket.io": "11.2.3",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "11.2.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.44.0",
